{
	"name": "@dynamsoft/document-scanner",
	"version": "2.0.0",
	"description": "Dynamsoft Mobile Document Scanner is a ready-to-use SDK for capturing, processing, editing, and exporting document images in the browser from cameras.",
	"keywords": [
		"camera",
		"document scanning",
		"dynamsoft",
		"javascript",
		"pdf",
		"scanner",
		"tiff",
		"ui",
		"vision"
	],
	"homepage": "https://www.dynamsoft.com/mobile-document-scanner/docs/web/index.html",
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Dynamsoft",
		"url": "https://www.dynamsoft.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Dynamsoft/document-scanner-javascript"
	},
	"files": [
		"/dist",
		"/CHANGELOG.md",
		"/THIRD-PARTY-NOTICES.md"
	],
	"type": "module",
	"sideEffects": false,
	"unpkg": "./dist/document-scanner.iife.js",
	"jsdelivr": "./dist/document-scanner.iife.js",
	"exports": {
		".": {
			"types": "./dist/document-scanner.d.mts",
			"default": "./dist/document-scanner.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"build:dev": "vp pack --sourcemap",
		"dev": "vp dev",
		"pack:local": "vp run build && vp pm pack --pack-destination dev",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"dynamsoft-capture-vision-bundle": "~3.6.5000",
		"dynamsoft-document-viewer": "~5.0.1",
		"playwright": "1.64.1",
		"publint": "^0.3.25",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"dynamsoft-capture-vision-bundle": "~3.6.5000",
		"dynamsoft-document-viewer": "~5.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.14.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^26.0.0",
			"onFail": "error"
		}
	}
}
