<?xml version="1.0" encoding="UTF-8"?>
<!-- Conventions: rule names must be unique; redirect targets are plainly
			root-relative (the old {HTTP_POST} server variable is undefined in
			IIS and always resolved empty); match patterns are anchored so they
			cannot also fire on the versioned copies which inherit
			this file's rules. Attributes left at their IIS defaults
			(patternSyntax="ECMAScript", ignoreCase="true", redirectType 301)
			are omitted. -->
<configuration>
	<system.webServer>
		<rewrite>
			<rules>
				<!-- Serve a .webp sibling for jpg/png requests when the browser
							accepts it and the file exists. Only the frozen Jekyll-era
							pages ship .webp copies; new-site images are content-hashed
							under /assets/ (paths the Jekyll site never used) so a stale
							.webp can never shadow them. -->
				<rule name="webp" stopProcessing="true">
					<match url="(.+)\.(jpe?g|png)$" />
					<conditions>
						<add input="{HTTP_ACCEPT}" pattern="image/webp" />
						<add input="{DOCUMENT_ROOT}/mobile-document-scanner/docs/web/{R:1}.webp" matchType="IsFile" />
					</conditions>
					<action type="Rewrite" url="{R:1}.webp" />
				</rule>

				<!-- Legacy URL redirects, grouped by destination. -->
				<rule name="Redirect introduction page">
					<match url="^introduction/index\.html$" />
					<action type="Redirect" url="/mobile-document-scanner/docs/web/index.html" appendQueryString="false" />
				</rule>
				<rule name="Redirect legacy guide pages">
					<match url="^(about/index|gettingstarted/helloworld|guides/document-scanner)\.html$" />
					<action type="Redirect" url="/mobile-document-scanner/docs/web/guide/index.html" appendQueryString="false" />
				</rule>
				<rule name="Redirect release notes">
					<match url="^release-notes/index\.html$" />
					<action type="Redirect" url="/mobile-document-scanner/docs/web/changelog.html" appendQueryString="false" />
				</rule>
				<rule name="Redirect MWC guide">
					<match url="^guides/mobile-web-capture\.html$" />
					<action type="Redirect" url="/mobile-document-scanner/docs/web/code-gallery/mobile-web-capture/index.html" appendQueryString="false" />
				</rule>
				<rule name="Redirect MWC customization guide">
					<match url="^guides/customization-guide\.html$" />
					<action type="Redirect" url="/mobile-document-scanner/docs/web/code-gallery/mobile-web-capture/customization-guide.html" appendQueryString="false" />
				</rule>
				<rule name="Redirect MWC API Reference">
					<match url="^api/mobile-web-capture\.html$" />
					<action type="Redirect" url="/mobile-document-scanner/docs/web/code-gallery/mobile-web-capture/api.html" appendQueryString="false" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>
