	},
	"devDependencies": {
		"@dynamsoft/vitepress-docs": "file:../../vitepress-docs",
		"typedoc": "^0.28.5",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.2",
		"vite-plus": "0.2.4",
		"vitepress": "^2.0.0-alpha.18"
	}
}
