{
	"name": "mds-docs",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"api": "typedoc",
		"dev": "npm run api && vitepress dev",
		"build": "npm run api && vitepress build",
		"preview": "vitepress preview",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"check": "vp check",
