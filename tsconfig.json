{
	"compilerOptions": {
		"target": "es2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"sourceMap": false,
		"noImplicitAny": true,
		"resolveJsonModule": true,
		"types": ["node", "vite-plus/client"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "vite/**/*.ts", "*.config.ts"]
}
